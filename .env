PREFIX=.

# Multi Prefix yang didukung: ., !, /, #, ?, $, &, @, +, -, =, ;, :, ~, `, |, ^, %
# User bisa pake salah satu dari prefix di atas

AUTO_READ=false
AUTO_TYPING=false
AUTO_RECORDING=false
AUTO_STATUS_VIEW=true
MAX_PREMIUM=10

# API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Timezone
TIMEZONE=Asia/Jakarta
