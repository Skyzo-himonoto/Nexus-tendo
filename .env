# ==============================================
# NEXUS TENDO MD - apikey 
# ==============================================
# Isi API Key yang lu buat
# Jangan dishare ke siapapun
# ==============================================

# konfigurasi bot
OWNER_NUMBER=628xxxxxxxxxx (nomor lu)
OWNER_NAME=YourName
BOT_NAME=NexusMD
SESSION_NAME=nexus-session
PREFIX=.

# Authentication Mode
# pilih salah satu:
# qr      - Scan QR code (default)
# pairing - Pakai pairing code 8 digit
AUTH_MODE=qr

# Auto features
AUTO_READ=false
AUTO_TYPING=false
AUTO_RECORDING=false
AUTO_STATUS_VIEW=true
MAX_PREMIUM=10

# API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Timezone
TIMEZONE=Asia/Jakarta
